# ──────────────────────────────────────────────
# CodeSync Environment Variables
# Copy to .env and fill in values
# ──────────────────────────────────────────────

# ── Server ──────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ── MongoDB ─────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/codesync

# ── Redis ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth (optional) ─────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ── Code Execution ──────────────────────────
EXECUTION_TIMEOUT_MS=5000
EXECUTION_MEMORY_LIMIT=128m
EXECUTION_CPU_LIMIT=0.5
MAX_EXECUTIONS_PER_MIN=10

# ── Logging ─────────────────────────────────
LOG_LEVEL=debug
